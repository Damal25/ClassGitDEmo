        "### Infant Hand Motion & Object Alignment Viewer\n",
        "This application simulates the user interface of `daniel/infant-hand-motion-viewer`, dynamically loading sequential frames, reconstructing 3D motion tracking joints of an infant's hand interacting with a toy, and displaying the physical metrics."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "b2c88ece",
        "outputId": "15ba8d6a-f758-4e7b-f93c-1fa9acf63506"
      },
      "source": [
        "import plotly.graph_objects as go\n",
        "import numpy as np\n",
        "\n",
        "def generate_infant_motion_data(num_frames=30):\n",
        "    \"\"\"\n",
        "    Generates smooth, anthropometrically-scaled 3D hand motion and object paths\n",
        "    resembling infant interaction recordings.\n",
        "    \"\"\"\n",
        "    np.random.seed(42)\n",
        "    time_steps = np.linspace(0, 2 * np.pi, num_frames)\n",
        "\n",
        "    # Smoothly moving base wrist trajectory\n",
        "    wrist_trajectory = np.stack([\n",
        "        0.1 * np.sin(time_steps),\n",
        "        0.05 * np.cos(time_steps * 2),\n",
        "        0.3 + 0.05 * np.sin(time_steps)\n",
        "    ], axis=1)\n",
        "\n",
        "    all_frames_joints = []\n",
        "    all_frames_objects = []\n",
        "\n",
        "    for t_idx, wrist in enumerate(wrist_trajectory):\n",
        "        # Infant hand dimensions are scaled smaller (~0.6x of adult)\n",
        "        joints = np.zeros((21, 3))\n",
        "        joints[0] = wrist\n",
        "\n",
        "        # Define finger offsets\n",
        "        for finger_idx in range(5):\n",
        "            base_offset = np.array([0.015 * (finger_idx - 2), 0.02, 0.01])\n",
        "            prev_joint = wrist + base_offset\n",
        "            joints[1 + finger_idx*4] = prev_joint\n",
        "\n",
        "            for phalanx in range(1, 4):\n",
        "                curr_idx = 1 + finger_idx*4 + phalanx\n",
        "                # Create subtle grasping movement over time\n",
        "                grasp_factor = 0.01 * np.sin(time_steps[t_idx])\n",
        "                growth = np.array([\n",
        "                    0.005 * np.sin(finger_idx),\n",
        "                    0.012 - abs(grasp_factor),\n",
