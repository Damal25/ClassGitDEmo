        "import os\n",
        "import glob\n",
        "import numpy as np\n",
        "import cv2\n",
        "\n",
        "# Ensure the Mock Aligner Class and variable 'aligner' are defined\n",
        "class HopFormerAligner:\n",
        "    def __init__(self):\n",
        "        pass\n",
        "    def estimate_pose(self, frame):\n",
        "        simulated_hand_joints = np.random.randn(21, 3) * 0.1\n",
        "        simulated_object_pose = np.random.randn(4, 4)\n",
        "        return simulated_hand_joints, simulated_object_pose\n",
        "\n",
        "aligner = HopFormerAligner()\n",
        "size = 0.06\n",
