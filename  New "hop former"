        "### Dynamic Infant Motion Tracking Visualization\n",
        "This cell implements an interactive visualizer equipped with a slider to scrub through the 30 processed tracking frames of infant hand motion and toy spatial alignments."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 542
        },
        "id": "de48b229",
        "outputId": "b79fd8b6-021d-4277-946d-f466a7f2ff3a"
      },
      "source": [
        "import plotly.graph_objects as go\n",
        "\n",
        "# Configure bone structure mapping\n",
        "finger_colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd']\n",
        "box_edges = [\n",
        "    (0, 1), (1, 2), (2, 3), (3, 0),\n",
        "    (4, 5), (5, 6), (6, 7), (7, 4),\n",
        "    (0, 4), (1, 5), (2, 6), (3, 7)\n",
        "]\n",
        "\n",
        "# Build figure\n",
        "fig = go.Figure()\n",
        "\n",
        "# Populate frames\n",
        "frames_data = []\n",
        "for t_idx in range(len(frames_joints)):\n",
        "    joints = frames_joints[t_idx]\n",
        "    vertices = frames_objects[t_idx]\n",
        "\n",
        "    # Trace for hand joints\n",
        "    hand_trace = go.Scatter3d(\n",
        "        x=joints[:, 0], y=joints[:, 1], z=joints[:, 2],\n",
        "        mode='markers', marker=dict(size=5, color='red'),\n",
        "        name='Hand Joints'\n",
        "    )\n",
        "\n",
        "    # Bone line traces\n",
        "    lines_x, lines_y, lines_z = [], [], []\n",
        "    for i in range(1, 21):\n",
        "        lines_x.extend([joints[0, 0], joints[i, 0], None])\n",
        "        lines_y.extend([joints[0, 1], joints[i, 1], None])\n",
        "        lines_z.extend([joints[0, 2], joints[i, 2], None])\n",
        "\n",
        "    skeleton_trace = go.Scatter3d(\n",
        "        x=lines_x, y=lines_y, z=lines_z,\n",
        "        mode='lines', line=dict(color='blue', width=3),\n",
        "        name='Hand Skeleton'\n",
        "    )\n",
        "\n",
        "    # Toy block object traces\n",
        "    obj_x, obj_y, obj_z = [], [], []\n",
        "    for edge in box_edges:\n",
        "        pt1 = vertices[edge[0]]\n",
        "        pt2 = vertices[edge[1]]\n",
        "        obj_x.extend([pt1[0], pt2[0], None])\n",
        "        obj_y.extend([pt1[1], pt2[1], None])\n",
        "        obj_z.extend([pt1[2], pt2[2], None])\n",
        "\n",
        "    object_trace = go.Scatter3d(\n",
        "        x=obj_x, y=obj_y, z=obj_z,\n",
        "        mode='lines+markers', line=dict(color='green', width=4),\n",
        "        marker=dict(size=3, color='darkgreen'),\n",
        "        name='Toy Block'\n",
        "    )\n",
        "\n",
        "    frames_data.append(go.Frame(\n",
        "        data=[hand_trace, skeleton_trace, object_trace],\n",
        "        name=f'frame_{t_idx}'\n",
        "    ))\n",
        "\n",
        "# Initialize with the first frame\n",
        "fig.add_trace(frames_data[0].data[0])\n",
        "fig.add_trace(frames_data[0].data[1])\n",
        "fig.add_trace(frames_data[0].data[2])\n",
        "\n",
        "# Configure slider controls\n",
        "sliders = [{\n",
        "    'active': 0,\n",
        "    'yanchor': 'top',\n",
        "    'xanchor': 'left',\n",
        "    'currentvalue': {\n",
        "        'font': {'size': 16},\n",
        "        'prefix': 'Interaction Frame: ',\n",
        "        'visible': True,\n",
        "        'xanchor': 'right'\n",
        "    },\n",
        "    'pad': {'b': 10, 't': 50},\n",
        "    'len': 0.9,\n",
        "    'x': 0.1,\n",
        "    'y': 0,\n",
        "    'steps': [{\n",
        "        'args': [\n",
        "            [f'frame_{i}'],\n",
        "            {\n",
        "                'frame': {'duration': 100, 'redraw': True},\n",
        "                'mode': 'immediate',\n",
        "                'transition': {'duration': 0}\n",
        "            }\n",
        "        ],\n",
        "        'label': str(i),\n",
        "        'method': 'animate'\n",
        "    } for i in range(len(frames_joints))]\n",
        "}]\n",
        "\n",
        "fig.frames = frames_data\n",
        "fig.update_layout(\n",
        "    title=\"Daniel Infant Hand-Motion and Toy Alignment Viewer\",\n",
        "    scene=dict(\n",
        "        xaxis=dict(title='X (meters)', range=[-0.2, 0.2]),\n",
        "        yaxis=dict(title='Y (meters)', range=[-0.15, 0.25]),\n",
        "        zaxis=dict(title='Z (meters)', range=[0.1, 0.5])\n",
        "    ),\n",
        "    sliders=sliders,\n",
        "    margin=dict(l=0, r=0, b=0, t=50)\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
